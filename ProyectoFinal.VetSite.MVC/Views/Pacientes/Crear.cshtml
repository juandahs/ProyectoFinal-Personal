@{
    ViewBag.Title = "Crear un paciente";
}

<section class="page-section">
    <div class="page-section-header">
        <div>
            <p class="page-section-kicker">Nuevo registro</p>
            <h2 class="page-section-title">@ViewBag.Title</h2>
            <p class="page-section-copy">Completa los datos básicos del paciente para habilitar sus futuras citas y procedimientos.</p>
        </div>
    </div>

    <form asp-action="Crear" method="post" class="form-shell">
        <partial name="_Formulario" model="Model" />
    </form>
</section>
