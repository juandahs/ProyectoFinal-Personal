@model IEnumerable<ProyectoFinal.Entidades.Examen>

<section class="page-section">
    <div class="page-section-header">
        <div>
            <p class="page-section-kicker">Diagnóstico</p>
            <h2 class="page-section-title">@ViewBag.Title</h2>
            <p class="page-section-copy">Revisa exámenes por tipo, fecha y profesional responsable desde una tabla consistente.</p>
        </div>

        <div class="page-actions">
            <a href="/Examenes/Crear" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>Nuevo examen
            </a>
        </div>
    </div>

    <div class="table-shell">
        <div class="table-meta">
            <span class="table-tag"><i class="fas fa-flask"></i>Resultados y solicitudes</span>
            <span>Busca por tipo, descripción o usuario que aplica el examen.</span>
        </div>

        <div class="table-responsive">
            <table id="examenesTable" class="table align-middle">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th>Fecha</th>
                        <th>Usuario que aplica</th>
                        <th class="text-center actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var examen in Model)
                        {
                            <tr>
                                <td><strong>@examen.TipoExamen!.Descripcion</strong></td>
                                <td>@examen.Descripcion</td>
                                <td>@examen.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@examen.Usuario!.Nombre</td>
                                <td class="text-center actions-cell">
                                    <div class="action-stack">
                                        <form asp-action="Editar" method="get">
                                            <input type="hidden" name="id" value="@examen.ExamenId" />
                                            <button type="submit" class="btn btn-primary action-btn" title="Editar examen" aria-label="Editar examen">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Eliminar" method="post">
                                            <input type="hidden" name="id" value="@examen.ExamenId" />
                                            <button type="submit" class="btn btn-danger action-btn" title="Eliminar examen" aria-label="Eliminar examen" onclick="return confirm('¿Está seguro de que desea eliminar este examen?');">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {

    <!-- DataTables JS para Bootstrap 5 -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#examenesTable').DataTable({
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    zeroRecords: "No se encontraron registros",
                    info: "Mostrando página _PAGE_ de _PAGES_",
                    infoEmpty: "No hay registros disponibles",
                    infoFiltered: "(filtrado de _MAX_ registros totales)",
                    paginate: {
                        previous: "<",
                        next: ">"
                    }

                }
            });
        });
    </script>
}
