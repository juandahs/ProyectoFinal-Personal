@model List<ProyectoFinal.Entidades.Usuario>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <p class="page-section-kicker">Equipo</p>
            <h2 class="page-section-title">@ViewBag.Title</h2>
            <p class="page-section-copy">Gestiona cuentas internas con acciones visibles y menos ruido alrededor de la tabla.</p>
        </div>

        <div class="page-actions">
            <a href="/Usuarios/Crear" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>Nuevo usuario
            </a>
        </div>
    </div>

    <div class="table-shell">
        <div class="table-meta">
            <span class="table-tag"><i class="fas fa-user-shield"></i>Acceso interno</span>
            <span>El cambio de clave sigue disponible desde la misma fila del usuario.</span>
        </div>

        <div class="table-responsive">
            <table id="usuariosTable" class="table align-middle">
                <thead>
                    <tr>
                        <th>Identificación</th>
                        <th>Nombre</th>
                        <th>Correo electrónico</th>
                        <th>Teléfono</th>
                        <th>Tarjeta profesional</th>
                        <th class="text-center actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <p class="empty-state-title">No hay usuarios registrados.</p>
                                    <p class="empty-state-copy">Agrega una cuenta para dar acceso operativo al equipo.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td><strong>@usuario.NumeroIdentificacion</strong></td>
                                <td>@usuario.Nombre</td>
                                <td>@usuario.CorreoElectronico</td>
                                <td>@usuario.Telefono</td>
                                <td>@usuario.TarjetaProfesional</td>
                                <td class="text-center actions-cell">
                                    <div class="action-stack">
                                        <form asp-action="Editar" method="get">
                                            <input type="hidden" name="id" value="@usuario.UsuarioId" />
                                            <button type="submit" class="btn btn-primary action-btn" title="Editar usuario" aria-label="Editar usuario">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                        </form>

                                        <button type="button" class="btn btn-warning action-btn cambiar-clave-btn"
                                                data-usuario-id="@usuario.UsuarioId"
                                                title="Cambiar clave"
                                                aria-label="Cambiar clave">
                                            <i class="fas fa-key"></i>
                                        </button>

                                        <form asp-action="Eliminar" method="post">
                                            <input type="hidden" name="id" value="@usuario.UsuarioId" />
                                            <button type="submit" class="btn btn-danger action-btn" title="Eliminar usuario" aria-label="Eliminar usuario"
                                                    onclick="return confirm('¿Está seguro de que desea eliminar este usuario?');">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_CambiarClave" />

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".cambiar-clave-btn").forEach(button => {
                button.addEventListener("click", function () {
                    const usuarioId = this.getAttribute("data-usuario-id");
                    document.getElementById('usuarioIdModal').value = usuarioId;

                    const modal = new bootstrap.Modal(document.getElementById('cambiarClaveModal'));
                    modal.show();
                });
            });

            document.getElementById("cerrarModalBtn").addEventListener("click", function () {
                const modal = bootstrap.Modal.getInstance(document.getElementById('cambiarClaveModal'));
                modal.hide();
            });

            $('#usuariosTable').DataTable({
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    zeroRecords: "No se encontraron registros",
                    info: "Mostrando página _PAGE_ de _PAGES_",
                    infoEmpty: "No hay registros disponibles",
                    infoFiltered: "(filtrado de _MAX_ registros totales)",
                    paginate: {
                        previous: "<",
                        next: ">"
                    }
                }
            });
        });
    </script>
}
