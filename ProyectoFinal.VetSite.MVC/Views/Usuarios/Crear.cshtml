@model ProyectoFinal.Entidades.Usuario

@{
    ViewBag.Title = "Crear un usuario";
}

<section class="page-section">
    <div class="page-section-header">
        <div>
            <p class="page-section-kicker">Nuevo acceso</p>
            <h2 class="page-section-title">@ViewBag.Title</h2>
            <p class="page-section-copy">Crea una cuenta operativa para el equipo con sus datos de identificación y contacto.</p>
        </div>
    </div>

    <form asp-action="Crear" method="post" class="form-shell">
        <partial name="_Formulario" model="Model" />
    </form>
</section>
