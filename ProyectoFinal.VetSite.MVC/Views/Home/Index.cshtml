@{
    ViewData["Title"] = "Inicio";
}

<section class="dashboard-hero">
    <article class="dashboard-hero-main">
        <span class="dashboard-badge">
            <i class="fas fa-heartbeat"></i>
            Operación central
        </span>
        <h2 class="dashboard-hero-title mt-3">Una vista más clara para la atención diaria de la clínica.</h2>
        <p class="dashboard-hero-copy">
            Entra rápido a los módulos con más uso, reduce el tiempo de búsqueda y mantén visible la información más relevante del día.
        </p>

        <div class="dashboard-hero-actions">
            <a asp-controller="Citas" asp-action="Index" class="btn btn-primary">
                <i class="far fa-calendar-check me-2"></i>Ver citas
            </a>
            <a asp-controller="Pacientes" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-paw me-2"></i>Consultar pacientes
            </a>
        </div>
    </article>

    <aside class="dashboard-hero-side">
        <p class="page-section-kicker">Enfoque</p>
        <h3 class="page-section-title">Prioridades del turno</h3>
        <div class="dashboard-note-list">
            <div class="dashboard-note">Agenda y estado de citas a un clic.</div>
            <div class="dashboard-note">Acceso directo a pacientes y propietarios.</div>
            <div class="dashboard-note">Módulos clínicos ordenados por frecuencia de uso.</div>
        </div>
    </aside>
</section>

<section class="dashboard-quick-grid mb-4">
    <article class="stat-card">
        <p class="stat-card-label">Agenda</p>
        <p class="stat-card-value">01</p>
        <p class="stat-card-copy">Agenda, asignación y seguimiento clínico.</p>
    </article>
    <article class="stat-card">
        <p class="stat-card-label">Pacientes y propietarios</p>
        <p class="stat-card-value">02</p>
        <p class="stat-card-copy">Datos de especie, estado y antecedentes básicos.</p>
    </article>
    <article class="stat-card">
        <p class="stat-card-label">Clínica</p>
        <p class="stat-card-value">03</p>
        <p class="stat-card-copy">Exámenes, vacunas y procedimientos desde accesos directos.</p>
    </article>
</section>

<section class="page-section">
    <div class="page-section-header">
        <div>
            <p class="page-section-kicker">Accesos rápidos</p>
            <h2 class="page-section-title">Módulos principales</h2>
            <p class="page-section-copy">La navegación prioriza las tareas más frecuentes para que el equipo entre más rápido al flujo correcto.</p>
        </div>
    </div>

    <div class="module-grid">
        <a asp-controller="Citas" asp-action="Index" class="module-card">
            <span class="module-card-icon"><i class="far fa-calendar-check"></i></span>
            <h3 class="module-card-title">Citas</h3>
            <p class="module-card-copy">Programa y revisa la atención del día con menos pasos.</p>
            <span class="module-card-link">Abrir módulo</span>
        </a>

        <a asp-controller="Pacientes" asp-action="Index" class="module-card">
            <span class="module-card-icon"><i class="fas fa-paw"></i></span>
            <h3 class="module-card-title">Pacientes</h3>
            <p class="module-card-copy">Consulta perfiles clínicos y actualiza sus datos básicos.</p>
            <span class="module-card-link">Abrir módulo</span>
        </a>

        <a asp-controller="Propietarios" asp-action="Index" class="module-card">
            <span class="module-card-icon"><i class="fas fa-address-card"></i></span>
            <h3 class="module-card-title">Propietarios</h3>
            <p class="module-card-copy">Mantén visible la información de contacto y soporte administrativo.</p>
            <span class="module-card-link">Abrir módulo</span>
        </a>

        <a asp-controller="Vacunas" asp-action="Index" class="module-card">
            <span class="module-card-icon"><i class="fas fa-syringe"></i></span>
            <h3 class="module-card-title">Vacunas</h3>
            <p class="module-card-copy">Controla aplicaciones, próximas fechas y seguimiento preventivo.</p>
            <span class="module-card-link">Abrir módulo</span>
        </a>

        <a asp-controller="Examenes" asp-action="Index" class="module-card">
            <span class="module-card-icon"><i class="fas fa-flask"></i></span>
            <h3 class="module-card-title">Exámenes</h3>
            <p class="module-card-copy">Registra resultados y solicitudes de diagnóstico clínico.</p>
            <span class="module-card-link">Abrir módulo</span>
        </a>

        <a asp-controller="Cirugias" asp-action="Index" class="module-card">
            <span class="module-card-icon"><i class="fas fa-user-md"></i></span>
            <h3 class="module-card-title">Cirugías</h3>
            <p class="module-card-copy">Consulta procedimientos y tipos quirúrgicos asociados.</p>
            <span class="module-card-link">Abrir módulo</span>
        </a>

        <a asp-controller="Usuarios" asp-action="Index" class="module-card">
            <span class="module-card-icon"><i class="fas fa-user-shield"></i></span>
            <h3 class="module-card-title">Usuarios</h3>
            <p class="module-card-copy">Gestiona accesos del equipo y tareas operativas internas.</p>
            <span class="module-card-link">Abrir módulo</span>
        </a>

        <a asp-controller="Configuracion" asp-action="Index" class="module-card">
            <span class="module-card-icon"><i class="fas fa-cog"></i></span>
            <h3 class="module-card-title">Configuración</h3>
            <p class="module-card-copy">Administra catálogos de tipos usados por los módulos clínicos.</p>
            <span class="module-card-link">Abrir configuración</span>
        </a>
    </div>
</section>
