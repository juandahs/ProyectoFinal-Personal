@model IEnumerable<ProyectoFinal.Entidades.TipoExamen>

<section class="page-section">
    <div class="page-section-header">
        <div>
            <p class="page-section-kicker">Configuración</p>
            <h2 class="page-section-title">@ViewBag.Title</h2>
            <p class="page-section-copy">Administra las categorías que se asignan a exámenes y resultados clínicos.</p>
        </div>

        <div class="page-actions">
            <a asp-controller="Configuracion" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Configuración
            </a>
            <a href="/TipoExamenes/Crear" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>Nuevo tipo
            </a>
        </div>
    </div>

    <div class="table-shell">
        <div class="table-meta">
            <span class="table-tag"><i class="fas fa-notes-medical"></i>Catálogo diagnóstico</span>
            <span>Busca por descripción antes de crear un nuevo tipo de examen.</span>
        </div>

        <div class="table-responsive">
            <table id="tipoexamenTable" class="table align-middle">
                <thead>
                    <tr>
                        <th>Descripción</th>
                        <th>Creado por</th>
                        <th>Fecha creación</th>
                        <th>Modificado por</th>
                        <th>Fecha modificación</th>
                        <th class="text-center actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var tipoExamen in Model)
                        {
                            <tr>
                                <td><strong>@tipoExamen.Descripcion</strong></td>
                                <td>@tipoExamen.UsuarioCreacion!.Nombre</td>
                                <td>@tipoExamen.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td>@tipoExamen.UsuarioModificacion!.Nombre</td>
                                <td>@tipoExamen.FechaModificacion.ToString("dd/MM/yyyy")</td>
                                <td class="text-center actions-cell">
                                    <div class="action-stack">
                                        <form asp-action="Editar" method="get">
                                            <input type="hidden" name="id" value="@tipoExamen.TipoExamenId" />
                                            <button type="submit" class="btn btn-primary action-btn" title="Editar tipo de examen" aria-label="Editar tipo de examen">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Eliminar" method="post">
                                            <input type="hidden" name="id" value="@tipoExamen.TipoExamenId" />
                                            <button type="submit" class="btn btn-danger action-btn" title="Eliminar tipo de examen" aria-label="Eliminar tipo de examen" onclick="return confirm('¿Está seguro de que desea eliminar este tipo de examen?');">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {

    <!-- DataTables JS para Bootstrap 5 -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tipoexamenTable').DataTable({
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    zeroRecords: "No se encontraron registros",
                    info: "Mostrando página _PAGE_ de _PAGES_",
                    infoEmpty: "No hay registros disponibles",
                    infoFiltered: "(filtrado de _MAX_ registros totales)",
                    paginate: {
                        previous: "<",
                        next: ">"
                    }
                }
            });
        });
    </script>
}
