@model IEnumerable<ProyectoFinal.Entidades.Vacuna>

<section class="page-section">
    <div class="page-section-header">
        <div>
            <p class="page-section-kicker">Prevención</p>
            <h2 class="page-section-title">@ViewBag.Title</h2>
            <p class="page-section-copy">Controla aplicaciones y próximas fechas de vacunación por paciente.</p>
        </div>

        <div class="page-actions">
            <a href="/Vacunas/Crear" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>Nueva vacuna
            </a>
        </div>
    </div>

    <div class="table-shell">
        <div class="table-meta">
            <span class="table-tag"><i class="fas fa-syringe"></i>Esquema preventivo</span>
            <span>Ordena por próxima aplicación para priorizar seguimientos.</span>
        </div>

        <div class="table-responsive">
            <table id="vacunasTable" class="table align-middle">
                <thead>
                    <tr>
                        <th>Paciente</th>
                        <th>Nombre</th>
                        <th>Fecha aplicación</th>
                        <th>Próxima aplicación</th>
                        <th class="text-center actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var vacuna in Model)
                        {
                            <tr>
                                <td><strong>@vacuna.Paciente!.Nombre</strong></td>
                                <td>@vacuna.NombreVacuna</td>
                                <td>@vacuna.FechaAplicacion.ToString("dd/MM/yyyy")</td>
                                <td>@vacuna.FechaProximaAplicacion.ToString("dd/MM/yyyy")</td>
                                <td class="text-center actions-cell">
                                    <div class="action-stack">
                                        <form asp-action="Editar" method="get">
                                            <input type="hidden" name="id" value="@vacuna.VacunaId" />
                                            <button type="submit" class="btn btn-primary action-btn" title="Editar vacuna" aria-label="Editar vacuna">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Eliminar" method="post">
                                            <input type="hidden" name="id" value="@vacuna.VacunaId" />
                                            <button type="submit" class="btn btn-danger action-btn" title="Eliminar vacuna" aria-label="Eliminar vacuna" onclick="return confirm('¿Está seguro de que desea eliminar esta vacuna?');">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {

    <!-- DataTables JS para Bootstrap 5 -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#vacunasTable').DataTable({
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    zeroRecords: "No se encontraron registros",
                    info: "Mostrando página _PAGE_ de _PAGES_",
                    infoEmpty: "No hay registros disponibles",
                    infoFiltered: "(filtrado de _MAX_ registros totales)",
                    paginate: {
                        previous: "<",
                        next: ">"
                    }

                }
            });
        });
    </script>
}
