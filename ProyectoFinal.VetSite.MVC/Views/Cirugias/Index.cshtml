@model IEnumerable<ProyectoFinal.Entidades.Cirugia>

<section class="page-section">
    <div class="page-section-header">
        <div>
            <p class="page-section-kicker">Procedimientos</p>
codex
            <p class="page-section-copy">Consulta las cirugías registradas por paciente, fecha y tipo de procedimiento.</p>
        </div>

        <div class="page-actions">
            <a href="/Cirugias/Crear" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>Nueva cirugía
            </a>
        </div>
    </div>

    <div class="table-shell">
        <div class="table-meta">
            <span class="table-tag"><i class="fas fa-user-md"></i>Historial quirúrgico</span>
            <span>Filtra por paciente, tipo o descripción para ubicar registros clínicos.</span>
        </div>

        <div class="table-responsive">
            <table id="cirugiasTable" class="table align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Paciente</th>
                        <th>Tipo de cirugía</th>
                        <th>Descripción</th>
                        <th class="text-center actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var cirugia in Model)
                        {
                            <tr>
                                <td>@cirugia.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td><strong>@(cirugia.Paciente?.Nombre ?? "Sin paciente")</strong></td>
                                <td>@(cirugia.TipoCirugia?.Descripcion ?? "Sin tipo")</td>
                                <td>@cirugia.Descripcion</td>
                                <td class="text-center actions-cell">
                                    <div class="action-stack">
                                        <form asp-action="Editar" method="get">
                                            <input type="hidden" name="id" value="@cirugia.CirugiaId" />
                                            <button type="submit" class="btn btn-primary action-btn" title="Editar cirugía" aria-label="Editar cirugía">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Eliminar" method="post">
                                            <input type="hidden" name="id" value="@cirugia.CirugiaId" />
                                            <button type="submit" class="btn btn-danger action-btn" title="Eliminar cirugía" aria-label="Eliminar cirugía" onclick="return confirm('¿Está seguro de que desea eliminar esta cirugía?');">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {

    <!-- DataTables JS para Bootstrap 5 -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#cirugiasTable').DataTable({
                language: {
                    search: "Buscar",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    zeroRecords: "No se encontraron registros",
                    info: "Mostrando página _PAGE_ de _PAGES_",
                    infoEmpty: "No hay registros disponibles",
                    infoFiltered: "(filtrado de _MAX_ registros totales)",
                    paginate: {
                        previous: "<",
                        next: ">"
                    }

                }
            });
        });
    </script>
}

