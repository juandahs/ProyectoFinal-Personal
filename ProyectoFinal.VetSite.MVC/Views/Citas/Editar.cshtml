@{
    ViewBag.Title = "Editar una cita";
}

<section class="page-section">
    <div class="page-section-header">
        <div>
            <p class="page-section-kicker">Reprogramación</p>
            <h2 class="page-section-title">@ViewBag.Title</h2>
            <p class="page-section-copy">Actualiza fecha, responsable o motivo sin perder contexto de la agenda.</p>
        </div>
    </div>

    <form asp-action="Editar" method="post" class="form-shell">
        <partial name="_Formulario" model="Model" />
    </form>
</section>
