@{
    ViewBag.Title = "Crear una cita";
}

<section class="page-section">
    <div class="page-section-header">
        <div>
            <p class="page-section-kicker">Nueva cita</p>
            <h2 class="page-section-title">@ViewBag.Title</h2>
            <p class="page-section-copy">Programa una atención vinculando paciente, profesional y motivo desde un solo formulario.</p>
        </div>
    </div>

    <form asp-action="Crear" method="post" class="form-shell">
        <partial name="_Formulario" model="Model" />
    </form>
</section>
