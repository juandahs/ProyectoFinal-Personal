@using ProyectoFinal.Entidades
@model ProyectoFinal.Entidades.Propietario

<div class="form-section-header">
    <h3 class="form-section-title">Datos del propietario</h3>
    <p class="form-note">Mantén actualizados los datos administrativos y de contacto vinculados al paciente.</p>
</div>

<div class="row form-grid">
    @if (Model != null)
    {
        <input type="hidden" asp-for="PropietarioId" />
        <input type="hidden" asp-for="UsuarioCreacionId" />
        <input type="hidden" asp-for="FechaCreacion" />
    }

    <div class="col-md-6 mb-3">
        <label asp-for="TipoIdentificacionId" class="form-label">Tipo de identificación*</label>
        <select asp-for="TipoIdentificacionId" class="form-select" required>
            <option value="">Seleccione un tipo</option>
            @foreach (var tipo in (ViewData["TiposIdentificacion"] as IEnumerable<TipoIdentificacion>)!)
            {
                <option value="@tipo.TipoIdentificacionId">@tipo.Descripcion</option>
            }
        </select>
        <span asp-validation-for="TipoIdentificacionId" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="NumeroIdentificacion" class="form-label">Número de identificación*</label>
        <input asp-for="NumeroIdentificacion" class="form-control" placeholder="Documento o registro" required maxlength="16" />
        <span asp-validation-for="NumeroIdentificacion" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Nombre" class="form-label">Nombre*</label>
        <input asp-for="Nombre" class="form-control" required maxlength="128" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Apellido" class="form-label">Apellido*</label>
        <input asp-for="Apellido" class="form-control" required maxlength="128" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="CorreoElectronico" class="form-label">Correo electrónico*</label>
        <input asp-for="CorreoElectronico" class="form-control" type="email" placeholder="correo@ejemplo.com" required maxlength="128" />
        <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Telefono" class="form-label">Teléfono*</label>
        <input asp-for="Telefono" id="telefonoInput" class="form-control" placeholder="3001234567" required maxlength="16" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>

    <div class="col-12 mb-3">
        <label asp-for="Direccion" class="form-label">Dirección</label>
        <input asp-for="Direccion" class="form-control" maxlength="128" placeholder="Dirección de contacto" />
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>
</div>

<div class="form-actions">
    <button type="submit" class="btn btn-success">Guardar propietario</button>
    <a href="@Url.Action("Index", "Propietarios")" class="btn btn-secondary">Cancelar</a>
</div>

<script>
    document.getElementById("telefonoInput").addEventListener("input", function () {
        this.value = this.value.replace(/\D/g, "");
    });
</script>
