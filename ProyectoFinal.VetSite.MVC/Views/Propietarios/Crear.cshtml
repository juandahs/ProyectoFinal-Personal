@{
    ViewBag.Title = "Crear un propietario";
}

<section class="page-section">
    <div class="page-section-header">
        <div>
            <p class="page-section-kicker">Nuevo contacto</p>
            <h2 class="page-section-title">@ViewBag.Title</h2>
            <p class="page-section-copy">Registra la información administrativa y de contacto que acompañará el historial del paciente.</p>
        </div>
    </div>

    <form asp-action="Crear" method="post" class="form-shell">
        <partial name="_Formulario" model="Model" />
    </form>
</section>
